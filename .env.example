# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/veloce"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Used to hash IPs/emails for rate limiting and logs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SECRET="change-me"

# --- Company profile (placeholders until real values are supplied) ---
COMPANY_NAME="Veloce"
COMPANY_DESCRIPTION="Veloce builds fast, practical, and reliable digital systems for businesses that need to turn ideas into working solutions."
COMPANY_CONTACT_EMAIL="veloceapp@gmail.com"
COMPANY_TIMEZONE="Asia/Manila"

# --- Notifications (optional; console provider is used when unset) ---
NOTIFY_TEAM_EMAIL=""
NOTIFY_FROM_EMAIL=""
RESEND_API_KEY=""
# EmailJS (takes priority over Resend when all four are set). See docs/EMAILJS.md
EMAILJS_SERVICE_ID="service_7lvdmxo"
EMAILJS_TEMPLATE_ID="template_962uzqr"
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
# Copy the referrer on introduction (only enable once email delivery is verified)
NOTIFY_REFERRER="false"

# --- Optional public channels shown in the footer (leave empty to hide) ---
COMPANY_WHATSAPP=""
SOCIAL_FACEBOOK_URL=""
SOCIAL_INSTAGRAM_URL=""
SOCIAL_LINKEDIN_URL=""
SOCIAL_GITHUB_URL=""
SOCIAL_X_URL=""
