generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  PROPOSAL_IN_PROGRESS
  CONVERTED
  NOT_PROCEEDING
}

enum LeadSource {
  DIRECT
  REFERRAL_VERIFIED
  REFERRAL_UNVERIFIED
}

enum LeadIntent {
  CONVERSATION
  CONSULTATION
  MEETING
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

enum ProjectType {
  NEW_PROJECT
  REDESIGN
  ECOMMERCE
  CUSTOM_WEB_APP
  INTEGRATION
  MAINTENANCE
  OTHER
}

enum WebsiteType {
  BUSINESS
  CORPORATE
  ECOMMERCE_STORE
  WEB_APP
  LANDING_PAGE
  OTHER
}

enum ProjectInterest {
  NEW_WEBSITE
  REDESIGN
  FEATURE_OR_INTEGRATION
  UNSURE
}

enum IntroductionStatus {
  RECEIVED
  REVIEWED
  CONTACTED
  DECLINED
}

enum NotificationKind {
  LEAD_TEAM
  LEAD_ACK
  INTRO_TEAM
  INTRO_REFERRER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Company {
  id           String   @id @default(cuid())
  name         String
  description  String
  logoUrl      String?
  websiteUrl   String?
  contactEmail String
  branding     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services  Service[]
  campaigns ReferralCampaign[]
  leads     Lead[]
}

model Service {
  id           String  @id @default(cuid())
  companyId    String
  slug         String
  title        String
  description  String
  benefit      String?
  icon         String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId, displayOrder])
}

model ReferralCampaign {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  publicToken      String    @unique
  referrerName     String?
  referrerRole     String?
  referrerCompany  String?
  /// Private. Never sent to the browser.
  referrerEmail    String?
  personalMessage  String?
  showReferrerName Boolean   @default(false)
  offerTitle       String?
  offerDescription String?
  offerStartsAt    DateTime?
  offerExpiresAt   DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads         Lead[]
  introductions ReferralIntroduction[]

  @@index([companyId, active])
}

model Lead {
  id                 String       @id @default(cuid())
  companyId          String
  name               String
  email              String
  companyName        String?
  currentWebsite     String?
  projectType        ProjectType
  websiteType        WebsiteType?
  serviceSlug        String?
  projectGoals       String
  additionalDetails  String?
  intent             LeadIntent   @default(CONVERSATION)
  status             LeadStatus   @default(NEW)
  source             LeadSource   @default(DIRECT)
  referralCampaignId String?
  idempotencyKey     String       @unique
  consentAt          DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company       Company           @relation(fields: [companyId], references: [id])
  campaign      ReferralCampaign? @relation(fields: [referralCampaignId], references: [id], onDelete: SetNull)
  attribution   LeadAttribution?
  notifications NotificationLog[]
  appointments  Appointment[]
  siteDraft     SiteDraft?

  @@index([status, createdAt])
  @@index([referralCampaignId])
  @@index([email])
}

/// A page the visitor designed in the /build editor and sent with their inquiry.
model SiteDraft {
  id         String   @id @default(cuid())
  leadId     String   @unique
  /// Public, unguessable token for the read-only preview at /build/preview/[token].
  token      String   @unique
  templateId String?
  /// Puck editor data (sanitised and size-capped on the server).
  data       Json
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadAttribution {
  id          String   @id @default(cuid())
  leadId      String   @unique
  landingPath String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ReferralIntroduction {
  id                String             @id @default(cuid())
  campaignId        String?
  referrerName      String
  referrerEmail     String
  referredName      String
  referredEmail     String
  referredCompany   String?
  projectInterest   ProjectInterest
  message           String?
  referrerConsentAt DateTime
  status            IntroductionStatus @default(RECEIVED)
  idempotencyKey    String             @unique
  createdAt         DateTime           @default(now())

  campaign      ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]

  @@index([campaignId])
  @@index([status, createdAt])
}

model NotificationLog {
  id             String             @id @default(cuid())
  kind           NotificationKind
  leadId         String?
  introductionId String?
  /// HMAC of the recipient address; the raw address is never logged.
  recipientHash  String
  status         NotificationStatus @default(PENDING)
  providerRef    String?
  attempts       Int                @default(0)
  lastError      String?
  dedupeKey      String             @unique
  leaseUntil     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  introduction ReferralIntroduction? @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

model BookingSession {
  id            String        @id @default(cuid())
  referenceHash String        @unique
  accessHash    String
  companyId     String
  eventTypeId   Int
  hostId        Int
  entryPoint    String
  campaignId    String?
  context       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  consentAt     DateTime
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  appointments  Appointment[]

  @@index([createdAt])
}

model Appointment {
  id                String            @id @default(cuid())
  sessionId         String
  leadId            String
  provider          String            @default("CAL")
  providerBookingId String
  eventTypeId       Int
  hostId            Int
  startAt           DateTime
  endAt             DateTime
  timezone          String
  location          String?
  status            AppointmentStatus
  providerUpdatedAt DateTime
  previousBookingId String?
  replacementId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  session           BookingSession    @relation(fields: [sessionId], references: [id])
  lead              Lead              @relation(fields: [leadId], references: [id])

  @@unique([provider, providerBookingId])
  @@index([sessionId])
  @@index([status, updatedAt])
}

model BookingEvent {
  id          String    @id @default(cuid())
  dedupeKey   String    @unique
  bookingUid  String
  trigger     String
  attempts    Int       @default(0)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model BookingSync {
  key       String    @id
  through   DateTime
  cursor    String?
  windowEnd DateTime?
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

/// A site-builder template uploaded by a developer from the live site (repo templates live in public/builder-templates).
model BuilderTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  websiteType String
  scheme      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions BuilderTemplateVersion[]
}

/// One immutable import of a template. Visitors only ever see PUBLISHED versions; designs keep the version they used.
model BuilderTemplateVersion {
  id             String                @id @default(cuid())
  templateId     String
  version        Int
  status         TemplateVersionStatus @default(DRAFT)
  /// The template package (lib/builder/template-package.ts) and its compiled stylesheet.
  package        Json
  css            String
  report         String
  thumbnails     Json
  /// Name typed by the developer when unlocking the panel, and a keyed hash of their IP.
  uploadedBy     String
  uploaderIpHash String
  createdAt      DateTime              @default(now())
  publishedAt    DateTime?

  template BuilderTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assets   BuilderTemplateAsset[]

  @@unique([templateId, version])
  @@index([status])
}

/// Fonts, images and thumbnails of an uploaded version, served from /build/t/<slug>/v<N>/<path>.
model BuilderTemplateAsset {
  id          String @id @default(cuid())
  versionId   String
  path        String
  contentType String
  bytes       Bytes

  version BuilderTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
}
