generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  PROPOSAL_IN_PROGRESS
  CONVERTED
  NOT_PROCEEDING
}

enum LeadSource {
  DIRECT
  REFERRAL_VERIFIED
  REFERRAL_UNVERIFIED
}

enum LeadIntent {
  CONVERSATION
  CONSULTATION
}

enum ProjectType {
  NEW_PROJECT
  REDESIGN
  ECOMMERCE
  CUSTOM_WEB_APP
  INTEGRATION
  MAINTENANCE
  OTHER
}

enum WebsiteType {
  BUSINESS
  CORPORATE
  ECOMMERCE_STORE
  WEB_APP
  LANDING_PAGE
  OTHER
}

enum ProjectInterest {
  NEW_WEBSITE
  REDESIGN
  FEATURE_OR_INTEGRATION
  UNSURE
}

enum IntroductionStatus {
  RECEIVED
  REVIEWED
  CONTACTED
  DECLINED
}

enum NotificationKind {
  LEAD_TEAM
  LEAD_ACK
  INTRO_TEAM
  INTRO_REFERRER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Company {
  id           String   @id @default(cuid())
  name         String
  description  String
  logoUrl      String?
  websiteUrl   String?
  contactEmail String
  branding     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services  Service[]
  campaigns ReferralCampaign[]
  leads     Lead[]
}

model Service {
  id           String  @id @default(cuid())
  companyId    String
  slug         String
  title        String
  description  String
  benefit      String?
  icon         String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId, displayOrder])
}

model ReferralCampaign {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  publicToken      String    @unique
  referrerName     String?
  referrerRole     String?
  referrerCompany  String?
  /// Private. Never sent to the browser.
  referrerEmail    String?
  personalMessage  String?
  showReferrerName Boolean   @default(false)
  offerTitle       String?
  offerDescription String?
  offerStartsAt    DateTime?
  offerExpiresAt   DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads         Lead[]
  introductions ReferralIntroduction[]

  @@index([companyId, active])
}

model Lead {
  id                 String     @id @default(cuid())
  companyId          String
  name               String
  email              String
  companyName        String?
  currentWebsite     String?
  projectType        ProjectType
  websiteType        WebsiteType?
  serviceSlug        String?
  projectGoals       String
  additionalDetails  String?
  intent             LeadIntent @default(CONVERSATION)
  status             LeadStatus @default(NEW)
  source             LeadSource @default(DIRECT)
  referralCampaignId String?
  idempotencyKey     String     @unique
  consentAt          DateTime
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company       Company           @relation(fields: [companyId], references: [id])
  campaign      ReferralCampaign? @relation(fields: [referralCampaignId], references: [id], onDelete: SetNull)
  attribution   LeadAttribution?
  notifications NotificationLog[]

  @@index([status, createdAt])
  @@index([referralCampaignId])
  @@index([email])
}

model LeadAttribution {
  id          String   @id @default(cuid())
  leadId      String   @unique
  landingPath String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ReferralIntroduction {
  id                String             @id @default(cuid())
  campaignId        String?
  referrerName      String
  referrerEmail     String
  referredName      String
  referredEmail     String
  referredCompany   String?
  projectInterest   ProjectInterest
  message           String?
  referrerConsentAt DateTime
  status            IntroductionStatus @default(RECEIVED)
  idempotencyKey    String             @unique
  createdAt         DateTime           @default(now())

  campaign      ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]

  @@index([campaignId])
  @@index([status, createdAt])
}

model NotificationLog {
  id             String             @id @default(cuid())
  kind           NotificationKind
  leadId         String?
  introductionId String?
  /// HMAC of the recipient address; the raw address is never logged.
  recipientHash  String
  status         NotificationStatus @default(PENDING)
  providerRef    String?
  attempts       Int                @default(0)
  lastError      String?
  dedupeKey      String             @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  introduction ReferralIntroduction? @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}
