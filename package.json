{
  "name": "veloce-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:booking": "node scripts/dev-booking.mjs",
    "build": "prisma generate && next build",
    "check:production": "node scripts/check-production.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "template:import": "node --conditions=react-server --import tsx scripts/import-template.ts",
    "template:publish": "tsx scripts/publish-template.ts",
    "analytics:password": "tsx scripts/template-password.ts --analytics-owner",
    "template:password": "tsx scripts/template-password.ts",
    "samples:screens": "tsx scripts/sample-screens.ts",
    "privacy:analytics": "node --conditions=react-server --import tsx scripts/analytics-privacy.ts",
    "privacy:record": "node --conditions=react-server --import tsx scripts/privacy-records.ts",
    "privacy:cleanup": "tsx scripts/cleanup-personal-data.ts",
    "security:photos": "tsx scripts/protect-portfolio.ts",
    "security:access": "node --conditions=react-server --import tsx scripts/security-access.ts",
    "security:totp": "node scripts/security-totp.mjs",
    "security:check": "node scripts/check-security.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@puckeditor/core": "0.23.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/node": "4.3.3",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.16",
    "dotenv": "^18.0.5",
    "fflate": "0.8.3",
    "framer-motion": "^13.5.0",
    "json5": "2.2.3",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "parse5": "8.0.1",
    "pg": "^8.23.1",
    "postcss": "8.5.28",
    "posthog-js": "^1.438.12",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@types/three": "^0.186.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
