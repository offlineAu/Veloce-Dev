# Merge into an existing TLS nginx configuration; do not replace TLS settings.
# These declarations belong in the http {} context.
limit_req_zone $binary_remote_addr zone=veloce_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=veloce_upload:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=veloce_connections:10m;
# Safe logs: $uri omits invitation/referral/query tokens.
log_format veloce_safe '$remote_addr $request_method $uri $status $request_time';

# Add these to the server {} context. Bind Next to loopback; firewall its port.
