# Use the hosted event and its existing credentials from .env.
# Register /api/booking/webhook on the production domain with the same secret.
BOOKING_ENABLED="true"
CAL_LOCAL_MODE="false"
CAL_API_BASE_URL="https://api.cal.com/v2/"
CAL_BOOKING_URL="https://cal.com/veloce-gyox9b/meeting-with-veloce"
CAL_EVENT_TYPE_ID="7375969"
CAL_HOST_ID="3326494"
CAL_API_KEY="cal_live_cc682877cf3ecf2b859cb626027354b2""
CAL_WEBHOOK_SECRET="CAL_WEBHOOK_SECRET"
BOOKING_DURATION_MINUTES="120"
BOOKING_FORMAT="Video call via Google Meet"
BOOKING_COST_LABEL="No charge for this introductory meeting"
BOOKING_CRON_SECRET="f0e3449c90b5a0a27b03a13ba20594fa61147fae94e0d6e2f3bbbff16f6e40d8"

# Developer template uploads (secret shortcut ⌘/Ctrl+Shift+Alt+T). Generate both with: npm run template:password
# Leave empty to switch uploads off.
TEMPLATE_UPLOAD_PASSWORD_HASH=
DEV_SESSION_SECRET=

# Optional production analytics. Keep disabled until project + privacy review are ready.
# Collection is also disabled in development/test and Vercel previews.
ANALYTICS_ENABLED=false
POSTHOG_PROJECT_KEY=
# eu (default) or us; ingestion endpoints are fixed, never taken from browser input.
POSTHOG_REGION=eu

# Private owner dashboard at /admin/analytics (optional; server-only).
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Generate both with npm run analytics:password. Do not reuse developer credentials.
ANALYTICS_OWNER_PASSWORD_HASH=
ANALYTICS_OWNER_SESSION_SECRET=

# Security: migrate the database before enabling owner/developer login.
SECURITY_CSP_MODE=report-only
# Required when analytics owner access is configured; npm run security:totp.
ANALYTICS_OWNER_TOTP_SECRET=
OWNER_SESSION_VERSION=1
DEV_SESSION_VERSION=1
# Vercel needs no override. Self-hosters must overwrite this header at ingress.
SECURITY_TRUSTED_IP_HEADER=
